# LAN address of the Daum Premium 8i
ERGO_IP=192.168.0.50
WEB_PORT=8080
# Set false when Zwift handles Strava uploads; local recording still continues.
# STRAVA_ENABLED=false
# Optional: a local config with preconfigured Strava app credentials
# CONFIG_FILE=./ErgoStravaLogger/config.local.json
# Optional: actual browser URL, especially when using a reverse proxy
# PUBLIC_BASE_URL=http://192.168.0.10:8080
